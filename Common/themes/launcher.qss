/* Lighting Designer Workstation - 统一启动器样式 */
QMainWindow {
    background-color: #18181b;
}

QFrame#titlebar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1a1a2e, stop:0.5 #16213e, stop:1 #0f3460);
    border-bottom: 1px solid #e8912d44;
}

QFrame#catcard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #252528, stop:1 #1e1e21);
    border: 1px solid #333;
    border-radius: 10px;
}

QPushButton#tool_btn {
    background: #2a2a2d;
    color: #ccc;
    border: 1px solid #333;
    border-left: 3px solid transparent;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 14px;
    text-align: left;
}

QPushButton#tool_btn:hover {
    background: #333;
    color: #fff;
}

QPushButton#accent_btn {
    background: #e8912d;
    color: #fff;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: bold;
}

QPushButton#accent_btn:hover {
    background: #f5a623;
}

QLineEdit#search_box {
    background: #252528;
    color: #e4e4e7;
    border: 1px solid #333;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
}

QLineEdit#search_box:focus {
    border: 1px solid #e8912d;
}

QTextEdit {
    background-color: #1e1e1e;
    color: #cccccc;
    border: 1px solid #3f3f46;
    border-radius: 3px;
}

QStatusBar {
    background: #007acc;
    color: #fff;
    font-size: 12px;
}